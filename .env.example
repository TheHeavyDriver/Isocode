# Copy to .env.local and fill in local values. Never commit real values.

# PostgreSQL connection string
DATABASE_URL=postgres://sahaj:sahaj@localhost:5435/sahaj_order

# 32+ byte random strings. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string
OTP_PEPPER=replace-with-a-long-random-string
EXPORT_SIGNING_SECRET=replace-with-a-long-random-string

# Demo only. Never set this for a real deployment with real users.
DEMO_OTP=123456

# Mock SMS logs nothing sensitive and accepts the demo OTP path.
SMS_PROVIDER=mock
SMS_API_KEY=

# AI provider: mock, openai, or anthropic. Mock uses the deterministic parser.
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=

# Public URL used in links and cookies
APP_URL=http://localhost:3000
